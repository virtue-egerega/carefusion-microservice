// ------------ Triage (11 §8–9) ------------

// The nursing station's assessment of an encounter. One current version; re-triaging or correcting
// adds a version that replaces it, and the old one stays on record (11 §8.1).
model TriageAssessment {
  id                  String            @id @default(uuid())
  encounterId         String
  presentingComplaint String                                // copied to Encounter.reasonForVisit
  onset               String?                               // free text: "2 days ago"
  painLocation        String?
  avpu                Avpu                                  // level of consciousness
  dangerSigns         DangerSign[]
  priority            QueuePriority                         // the nurse's decision
  suggestedPriority   QueuePriority?                        // what the protocol suggested, kept beside it
  replacesId          String?           @unique             // the version this one replaces
  changeReason        String?                               // why it was re-triaged or corrected
  triagedBy           String
  triagedAt           DateTime          @default(now())

  encounter           Encounter         @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  replaces            TriageAssessment? @relation("TriageVersions", fields: [replacesId], references: [id], onDelete: Cascade)
  replacedBy          TriageAssessment? @relation("TriageVersions")

  @@index([encounterId, triagedAt])
}

// One reading of vital signs. Corrections add a reading that replaces it; removals keep it on
// record, struck through (11 §9).
model Vitals {
  id              String        @id @default(uuid())
  encounterId     String
  context         VitalsContext @default(TRIAGE)
  takenAt         DateTime                          // when it was taken, not typed
  temperature     Decimal?      @db.Decimal(3, 1)   // °C
  pulse           Int?                              // bpm
  respiratoryRate Int?                              // /min
  systolic        Int?                              // mmHg
  diastolic       Int?                              // mmHg
  spo2            Int?                              // %
  painScore       Int?                              // 0–10
  bloodGlucose    Decimal?      @db.Decimal(3, 1)   // mmol/L
  weight          Decimal?      @db.Decimal(5, 2)   // kg
  height          Decimal?      @db.Decimal(4, 1)   // cm
  notes           String?
  replacesId      String?       @unique            // the reading this corrects
  editReason      String?                          // required on a correction
  removedAt       DateTime?
  removedBy       String?
  removeReason    String?
  recordedBy      String
  recordedAt      DateTime      @default(now())

  encounter       Encounter     @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  replaces        Vitals?       @relation("VitalsCorrections", fields: [replacesId], references: [id], onDelete: Cascade)
  replacedBy      Vitals?       @relation("VitalsCorrections")

  @@index([encounterId, takenAt])
}

enum Avpu {
  ALERT
  VOICE
  PAIN
  UNRESPONSIVE
}

enum DangerSign {
  UNABLE_TO_DRINK
  PERSISTENT_VOMITING
  CONVULSIONS
  LETHARGY
  SEVERE_DEHYDRATION
  DIFFICULTY_BREATHING
}

enum VitalsContext {
  TRIAGE
  OBSERVATION
  WARD_ROUND
  PRE_OP
  POST_OP
}


// ------------ Consultations (14) ------------

// The doctor's note for an encounter. Several per encounter; at most one per doctor's task (14 §2).
// Draft while written by its author; signing locks it, and later additions are addenda (14 §7).
model Consultation {
  id                  String               @id @default(uuid())
  organizationId      String
  encounterId         String
  patientId           String
  queueEntryId        String?              @unique   // the doctor's task it was written in; null for a ward round
  clinicId            String?                        // the encounter's clinic when started
  doctorId            String                         // the author: only they edit the draft
  type                ConsultationKind     @default(INITIAL)
  status              ConsultationStatus   @default(DRAFT)

  presentingHistory   String?                        // history of presenting complaint (14 §3.2)
  pastSurgicalHistory String?
  currentMedications  String?                        // drug history, including herbal / OTC (14 §3.5)
  adherence           MedicationAdherence?
  adherenceNote       String?
  socialHistory       String?
  smoking             SmokingStatus?
  alcohol             AlcoholUse?
  familyHistory       String?

  birthHistory        String?                        // children (14 §3.8)
  immunisationHistory String?
  developmentHistory  String?
  feedingHistory      String?

  lastMenstrualPeriod DateTime?            @db.Date  // women of reproductive age (14 §3.8)
  gravida             Int?
  parity              Int?                           // births after 28 weeks: the "P2" of "G3P2+1"
  abortions           Int?                           // losses before 28 weeks: the "+1"
  contraception       String?

  generalExamNote     String?
  summary             String?
  impression          String?
  advice              String?                        // counselling and warning signs, printable for the patient
  planNotes           String?
  followUpOn          DateTime?            @db.Date
  outcome             ConsultationOutcome?
  outcomeNote         String?

  startedAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  signedAt            DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  encounter           Encounter            @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queueEntry          QueueEntry?          @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  clinic              Clinic?              @relation(fields: [clinicId], references: [id])
  complaints          ConsultationComplaint[]
  reviewFindings      ConsultationReviewFinding[]
  systemReviews       ConsultationSystemReview[]
  generalSigns        ConsultationGeneralSign[]
  examFindings        ConsultationExamFinding[]
  examinations        ConsultationExamination[]
  diagnoses           Diagnosis[]
  addenda             ConsultationAddendum[]

  @@index([encounterId])
  @@index([patientId, startedAt])
  @@index([organizationId, doctorId, status])
}

// What the patient came with, in their words: "Fever × 3/7" (14 §3.1)
model ConsultationComplaint {
  id             String       @id @default(uuid())
  consultationId String
  complaint      String
  duration       String?                            // free text: "3 days", "since childhood"
  position       Int                                // the order the doctor listed them

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, position])
}

// Review of systems, per symptom from the standard list (14 §3.3): positive or negative. A symptom
// not asked about has no row: "not assessed" is never read as denied.
model ConsultationReviewFinding {
  id             String        @id @default(uuid())
  consultationId String
  symptom        String                             // a code from review-of-systems.catalog.ts: "HAEMOPTYSIS"
  finding        ReviewFinding
  note           String?                            // "productive, 2 weeks"

  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, symptom])
}

// A body system's note in the review of systems: symptoms not on the list, comments (14 §3.3)
model ConsultationSystemReview {
  id             String       @id @default(uuid())
  consultationId String
  system         BodySystem
  note           String

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, system])
}

// General examination checklist: a sign listed was examined, present or absent (14 §4.1)
model ConsultationGeneralSign {
  id             String       @id @default(uuid())
  consultationId String
  sign           GeneralSign
  present        Boolean
  grade          Int?                               // 1–3 (+ to +++), present signs only
  note           String?

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, sign])
}

// Systemic examination, per item from the standard list (14 §4.2): normal, or abnormal with a note.
// An item not examined has no row: "not examined" is never read as normal.
model ConsultationExamFinding {
  id             String       @id @default(uuid())
  consultationId String
  element        String                             // a code from examination.catalog.ts: "HEART_SOUNDS"
  finding        ExamFinding
  note           String?                            // required when ABNORMAL

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, element])
}

// A body system's note in the systemic examination: anything not on the list (14 §4.2)
model ConsultationExamination {
  id             String       @id @default(uuid())
  consultationId String
  system         BodySystem
  note           String

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, system])
}

// A coded diagnosis. The patient's diagnoses across visits are their past medical history (14 §3.4, §5).
model Diagnosis {
  id             String              @id @default(uuid())
  consultationId String
  encounterId    String
  patientId      String
  codeSystem     DiagnosisCodeSystem @default(ICD_10)
  code           String
  description    String                             // copied from the code list at the time
  isPrimary      Boolean             @default(false) // at most one per consultation (partial unique index in SQL)
  certainty      DiagnosisCertainty
  reported       Boolean             @default(false) // diagnosed elsewhere, from the history
  note           String?
  recordedBy     String
  recordedAt     DateTime            @default(now())

  consultation   Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  encounter      Encounter           @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient        Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnosisCode  DiagnosisCode       @relation(fields: [codeSystem, code], references: [codeSystem, code])

  @@unique([consultationId, codeSystem, code])
  @@index([patientId, recordedAt])
  @@index([encounterId])
}

// The ICD-10 list, shared by every hospital; retired codes stay for old diagnoses (14 §5)
model DiagnosisCode {
  codeSystem DiagnosisCodeSystem
  code       String                                 // "B54", "I10", "E11.9"
  title      String
  chapter    String?
  selectable Boolean             @default(true)  // false for a heading with subdivisions (B50): code to the most specific level
  isActive   Boolean             @default(true)

  diagnoses  Diagnosis[]

  @@id([codeSystem, code])
}

// The code list's chapters and groups, for browsing it (14 §5): "I Certain infectious and parasitic
// diseases", "A00–A09 Intestinal infectious diseases". position keeps WHO's order (chapter XXII, U, is last).
model DiagnosisChapter {
  codeSystem DiagnosisCodeSystem
  number     String                                 // "01"
  numeral    String                                 // "I"
  title      String
  position   Int

  @@id([codeSystem, number])
}

model DiagnosisCodeGroup {
  codeSystem DiagnosisCodeSystem
  firstCode  String                                 // "A00"
  lastCode   String                                 // "A09": the group holds every code from A00 to A09.9
  chapter    String                                 // the chapter's number, "01"
  title      String
  position   Int

  @@id([codeSystem, firstCode])
  @@index([codeSystem, chapter])
}

// Added to a signed note, attributed to whoever adds it (14 §7)
model ConsultationAddendum {
  id             String       @id @default(uuid())
  consultationId String
  text           String
  addedBy        String
  addedAt        DateTime     @default(now())

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, addedAt])
}

enum ConsultationKind {
  INITIAL
  FOLLOW_UP
  RESULT_REVIEW
