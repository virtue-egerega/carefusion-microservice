  UNDER_FIVE
  CHILD
  ADOLESCENT
  ADULT
  OLDER_ADULT
}

// Declaration order is the call order: worklists sort by it ascending
enum QueuePriority {
  EMERGENCY
  URGENT
  ROUTINE
}

enum QueueEntryStatus {
  WAITING      // on the list, not yet cleared to be served (e.g. an order waiting on payment)
  HELD         // in the queue but not callable yet (holdReason)
  AWAITING_SERVICE // cleared to be served, ahead of WAITING: a funded visit's tasks (11 §6.2), or paid after an interruption
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW      // reserved: nothing marks a task no-show automatically (11 §5.5)
  TRANSFERRED
  CANCELLED
}

