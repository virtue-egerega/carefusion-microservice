  AFTER    // nothing is held; the patient pays everything at the end
}

enum PasswordChangeReason {
  ADMIN_RESET   // an admin issued a temporary password; the user must change it at next login
  USER_CHANGE   // the user changed their own password
}

// ------------ Encounters & queues (PRD 11) ------------

/// Whether the patient was admitted to a bed. Not the kind of visit:
/// the clinic is clinicId, how they came is visitType.
enum EncounterType {
  OUTPATIENT   // not admitted (clinic, emergency, service-only)
  INPATIENT    // admitted; set once, at bed assignment (11 §13.4), and never reverts
}

// Open while any station still has a task for the patient (11 §4.1). firstSeenAt records whether
// a clinician has seen them; disposition records the clinical outcome.
enum EncounterStatus {
  OPEN        // at least one task (queue entry) is active, or none finished the visit yet
  CLOSED      // the last task was completed with nowhere next, or cancelled
  CANCELLED   // opened in error; nothing clinical recorded
}

// How the patient came (11 §3.1)
enum VisitType {
  WALK_IN
  APPOINTMENT
  REFERRAL_IN
  SELF_PRESENTED_EMERGENCY
  AMBULANCE
  POLICE
  TRANSFER_IN
  SERVICE_ONLY
  BIRTH
}

// Emergency triage acuity (11 §8), as clinical levels; the colour each scale shows is the
// frontend's concern. Declaration order is most urgent first: task lists sort by it ascending.
enum Acuity {
  IMMEDIATE         // treat now
  VERY_URGENT       // within 10 minutes
  URGENT            // within 60 minutes
  ROUTINE           // within 4 hours
  DEAD_ON_ARRIVAL
}

enum Disposition {
  DISCHARGED_HOME
  TRANSFERRED_OUT
  REFERRED_OUT
  LEFT_WITHOUT_BEING_SEEN
  LEFT_BEFORE_COMPLETION    // seen, then left with tasks unfinished; recorded by staff after following up
  LEFT_AGAINST_ADVICE
  ABSCONDED
  DIED
  BROUGHT_IN_DEAD
  SERVICE_COMPLETED
}

// Same values as the shared AgeGroup enum (06 §2.7)
enum AgeGroup {
  NEONATE
  INFANT
  UNDER_FIVE
  CHILD
  ADOLESCENT
  ADULT
  OLDER_ADULT
}

// Declaration order is the call order: worklists sort by it ascending
enum QueuePriority {
  EMERGENCY
  URGENT
  ROUTINE
}

enum QueueEntryStatus {
  WAITING      // callable
  HELD         // in the queue but not callable yet (holdReason)
  AWAITING_SERVICE // paid after a hold that interrupted service (pharmacy priced it, patient went to pay): callable, ahead of WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW      // reserved: nothing marks a task no-show automatically (11 §5.5)
  TRANSFERRED
  CANCELLED
}

enum HoldReason {
  AWAITING_PAYMENT   // the payment gate (11 §6)
  AWAITING_PREAUTH
  AWAITING_RESULT
}
