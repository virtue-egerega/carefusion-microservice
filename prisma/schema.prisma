// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {

  id                    String   @id @default(uuid())
  name                  String
  address               String
  logo                  String?
  phone                 String[]
  email                 String
  city                  String
  state                 String
  country               String
  zipCode               String
  website               String?
  slogan                String?
  pobox                 String?
  nfcCardFee            Decimal @default(1000.00)
  registrationFee       Decimal @default(0.00)
  consultationFee       Decimal @default(0.00) // posted at check-in to a clinic (11 §10.4); one flat fee until the price catalog (11 Q5)
  consultationPayment   ConsultationPayment @default(BEFORE) // fund the account before the encounter starts, or owe within maxUnpaidBeforeHold (11 §6.2)
  maxUnpaidBeforeHold   Decimal @default(0.00) // AFTER: how far an account may owe once the consultation fee is charged (11 §6.2)
  patientNumberStart    Int     @default(1001) // first patient number; numbers never go below it (06 §3). Raised, never lowered.
  // Age-group settings (06 §2.7). Early-life bands default to the standard values; the hospital may change them.
  neonateMaxDays        Int     @default(28)    // NEONATE up to this many days
  infantBelowYears      Int     @default(1)     // INFANT below this age
  underFiveBelowYears   Int     @default(5)     // UNDER_FIVE below this age
  childMaxYears         Int     @default(12)    // CHILD up to this age, then ADOLESCENT
  paediatricMaxAge      Int?                    // last age (years) treated as paediatric; set by the hospital
  geriatricMinAge       Int?                    // first age (years) treated as older adult; set by the hospital
  nearExpiryDays        Int     @default(90)    // stock expiring within this many days is flagged (15 §12.2)
  paymentPlan           PaymentPlan?
  businessType          BusinessType @default(HOSPITAL)
  orgType               OrgType @default(STANDALONE)
  healthcareNetworkId   String?
  healthcareNetworkName String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime? @updatedAt
  deletedBy             String?


  branches               Branch[]
  staffs                 HospitalStaff[]
  patients               Patient[]
  billingAccounts        BillingAccount[]
  payers                 Payer[]
  financialRequests      FinancialRequest[]
  approvalPolicies       ApprovalPolicy[]
  encounters             Encounter[]
  billableCategories     BillableCategory[]
  billableItems          BillableItem[]
  clinicBillableItems    ClinicBillableItem[]
  consultations          Consultation[]
  medicines              Medicine[]
  suppliers              Supplier[]
  manufacturers          Manufacturer[]
  storageLocations       StorageLocation[]
  goodsReceipts          GoodsReceipt[]

}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String       @unique
  address        String
  city           String
  state          String
  country        String
  phone          String[]
  email          String?
  isMainBranch   Boolean      @default(false)
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  charges        Charge[]
  accountEntries AccountEntry[]
  staff          HospitalStaff[]
  patients       Patient[]
  encounters     Encounter[]
  queueEntries   QueueEntry[]
  storageLocations  StorageLocation[]
  goodsReceipts     GoodsReceipt[]
  stockTransactions StockTransaction[]

  @@index([organizationId])
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  firstName             String
  middleName            String?
  lastName              String
  phone                 String[]
  type                  UserType
  status                UserStatus @default(ACTIVE)
  loginAttempts         Int       @default(0)
  mustChangePassword    Boolean   @default(false) // set when an admin issues a temporary password (creation or reset)
  lastLogin             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  updatedBy             String?         // userId of the user who updated this role
  deletedAt             DateTime?       // soft delete
  deletedBy             String?         // userId of the user who updated this role

  personalAccessTokens  PersonalAccessToken[]
  passwordHistory       PasswordHistory[]
  address              Address[]

  staff                 HospitalStaff?
  patient               Patient?
  nhisWorker            NHISWorker?
  publicHealthWorker    PublicHealthWorker?

  @@index([email, lastName], name: "email_lastname_index")
  @@index([phone, lastName], name: "phone_lastname_index")
}


model PasswordHistory{
  id          String @id @default(uuid())
  userId      String
  password    String                         // the hash that was replaced
  changedBy   String?                        // who set the new password: the admin (reset) or the user
  reason      PasswordChangeReason?
  createdAt   DateTime @default(now())
  updatedAt   DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/* PersonalAccessToken - for all types of code verification*/
model PersonalAccessToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  type       TokenType
  expiry     DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type])
}


// ------------ ACCESS CONTROL ------------

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  dutyProfilePermissions DutyProfilePermission[]
}

model DutyProfile {
  id           String            @id @default(uuid())
  name         String            @unique
  role         HospitalStaffRole
  departmentId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  department  Department? @relation(fields: [departmentId], references: [id])
  queues      DutyProfileQueue[]
  sendQueues  DutyProfileSendQueue[]
  permissions DutyProfilePermission[]
  assignments StaffAssignment[]
  approvalLimits ApprovalLimit[]
}

model DutyProfileQueue {
  id            String @id @default(uuid())
  dutyProfileId String
  queueId       String

  dutyProfile DutyProfile @relation(fields: [dutyProfileId], references: [id], onDelete: Cascade)
  queue       Queue       @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@unique([dutyProfileId, queueId])
}

// Queues this profile may put patients on (11 §5.7): reception → billing, nursing stations. Unlike
// DutyProfileQueue it grants no access to the queue's list or its patients (05 §7).
model DutyProfileSendQueue {
  id            String @id @default(uuid())
  dutyProfileId String
  queueId       String

  dutyProfile DutyProfile @relation(fields: [dutyProfileId], references: [id], onDelete: Cascade)
  queue       Queue       @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@unique([dutyProfileId, queueId])
}

model DutyProfilePermission {
  id            String @id @default(uuid())
  dutyProfileId String
  permissionId  String

  dutyProfile DutyProfile @relation(fields: [dutyProfileId], references: [id], onDelete: Cascade)
  permission  Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([dutyProfileId, permissionId])
}

model StaffAssignment {
  id            String    @id @default(uuid())
  staffId       String
  dutyProfileId String
  assignedBy    String
  assignedAt    DateTime  @default(now())
  endsAt        DateTime?

  staff       HospitalStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dutyProfile DutyProfile   @relation(fields: [dutyProfileId], references: [id], onDelete: Cascade)

  @@unique([staffId, dutyProfileId])
}

// ------------ DEPARTMENTS & QUEUES ------------

model Department {
  id          String    @id @default(uuid())
  systemKey   String    @unique
  name        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  staff        HospitalStaff[]
  queues       Queue[]
  dutyProfiles DutyProfile[]
  encounters   Encounter[]
  clinics      Clinic[]
}

model Queue {
  id           String     @id @default(uuid())
  departmentId String
  systemKey    String     @unique
  name         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  department        Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  dutyProfileQueues DutyProfileQueue[]
  sendingProfiles   DutyProfileSendQueue[]
  entries           QueueEntry[]
  triageForClinics  Clinic[]   @relation("ClinicTriage")
  doctorsForClinics Clinic[]   @relation("ClinicConsultation")

  @@index([departmentId])
}

// What a patient comes to see (11 §3.3): reception checks patients into clinics, not departments.
// System-defined like queues (departments.catalog.ts); hospitals may rename or deactivate them.
// Several clinics can share one nursing station (Diabetes and Hypertension → Medical Nursing Station).
model Clinic {
  id                  String     @id @default(uuid())
  systemKey           String     @unique
  name                String
  departmentId        String                         // who runs it
  triageQueueId       String                         // the nursing station patients wait at first
  consultationQueueId String                         // the doctors' task list
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  updatedBy           String?

  department          Department @relation(fields: [departmentId], references: [id])
  triageQueue         Queue      @relation("ClinicTriage", fields: [triageQueueId], references: [id])
  consultationQueue   Queue      @relation("ClinicConsultation", fields: [consultationQueueId], references: [id])
  encounters          Encounter[]
  billableItems       ClinicBillableItem[]
  consultations       Consultation[]

  @@index([departmentId])
}

// ------------ STAFF ------------
model HospitalStaff {
  id             String      @id @default(uuid()) @map("user_id")
  user           User        @relation(fields: [id], references: [id], onDelete: Cascade)
  departmentId   String?
  hospitalId     String?
  branchId       String                        // home branch; carried in the login token (09 §9.1)
  role           HospitalStaffRole?
  createdAt      DateTime    @default(now())
  createdBy      String?                       // admin who created the account (and issued its first password)

  department     Department?    @relation(fields: [departmentId], references: [id])
  hospital       Organization?  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id])
  assignments    StaffAssignment[]
}

// ------------ PATIENT ------------

model Address {
  id                    String      @id @default(uuid())
  street                String
  city                  String
  state                 String
  country               String
  postalCode            String?
  type                  AddressType
  userId                String?     // If tied to User
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  updatedBy             String?         // userId of the user who updated this role
  deletedAt             DateTime?       // soft delete
  deletedBy             String?


  user                  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type]) // 👈 ensures 1 address per type per patient
}

model Patient {
  id                    String  @id @default(uuid())  @map("user_id")
  patientNumber         Int                // the patient's hospital number, given to every patient at registration (and printed on their NFC card if one is issued): sequential per organisation, handed out in memory (06 §3)
  nfcId                 String? @unique    // the card chip's own ID; set when a card is scanned and linked, not at registration
  nfcLinkedAt           DateTime?          // when the card was linked to the patient
  nfcLinkedBy           String?          // who did the linking
  dateOfBirth           DateTime?
  sex                   Gender?
  maritalStatus         MaritalStatus?
  nationality           String?
  occupation            String?
  religion              String?
  ethnicity             String?
  spokenLanguages       String[]
  bloodGroup            BloodGroup?
  genotype              Genotype?
  emergencyContactId    String?
  emergencyContact       NextOfKin[]
  hospitalId             String  @map("hospital_id")
  branchId               String                        // registering branch (06 §2.1), from the staff member's token

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                      User    @relation(fields: [id], references: [id], onDelete: Cascade)
  hospital                  Organization    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch                    Branch          @relation(fields: [branchId], references: [id])

  heldBillingAccounts       BillingAccount[]       @relation("AccountHolder")
  billingMemberships        BillingAccountMember[]
  principalPolicies         Policy[]               @relation("PolicyPrincipal")
  coverages                 Coverage[]
  charges                   Charge[]
  accountEntries            AccountEntry[]
  encounters                Encounter[]
  queueEntries              QueueEntry[]
  consultations             Consultation[]
  diagnoses                 Diagnosis[]

  @@unique([hospitalId, patientNumber])

  @@index([branchId])

}

model NextOfKin {
  id              String   @id @default(uuid())
  patientId       String
  firstName       String
  middleName      String
  lastName        String
  relationship    String   // e.g. "Mother", "Brother", "Spouse"
  phone           String[]
  email           String?
  address         String?
  isEmergencyContact Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId, isEmergencyContact], name: "emergency_contact_index")
  @@index([patientId], name: "patient_contact_index")
  @@unique([patientId, isEmergencyContact])
}


// ------------ NHIS WORKER ------------
// insurance works account
model NHISWorker {
  id                    String   @id @default(uuid()) @map("user_id")
  user                  User     @relation(fields: [id], references: [id], onDelete: Cascade)
  role                  NHISRole?
  payerId               String

  payer                 Payer    @relation(fields: [payerId], references: [id])

}


// ------------ PUBLIC HEALTH WORKER ------------

model PublicHealthWorker {
  id              String   @id @default(uuid()) @map("user_id")
  user            User     @relation(fields: [id], references: [id], onDelete: Cascade)
  role            PublicHealthRole?
}


// ------------ NOTIFICATIONS ------------

model Notification {
  id          String @id @default(uuid())
  userId      String
  message     String
  type        NotificationType
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

}


// ------------ APPOINTMENTS ------------


model ConsultationType {
  id              String     @id @default(uuid())
  name            String     @unique
  description     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  updatedBy             String?         // userId of the user who updated this role
  deletedAt             DateTime?       // soft delete
  deletedBy             String?

  appointments          Appointment[]
}

// doctors and front desk can schedule appointment
model Appointment {
  id                          String     @id @default(uuid())
  hospitalId                  String
  date                        DateTime
  appointmentStartedAt        DateTime?
  appointmentEndedAt          DateTime?
  checkin                     Boolean? @default(false)
  checkinAt                   DateTime?
  status                      AppointmentStatus @default(SCHEDULED)
  reason                      ConsultationReason
  consultationTypeId          String
  patientId                   String
  doctorId                    String
  referralNote                String?
  referredById                String?

  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  updatedBy                   String?         // userId of the user who updated this role
  deletedAt                   DateTime?       // soft delete
  deletedBy                   String?
  consultationType            ConsultationType @relation(fields: [consultationTypeId], references: [id], onDelete: NoAction)
  encounter                   Encounter?

  @@index([patientId])
  @@index([hospitalId])
  @@index([date])
  @@index([checkinAt])
  @@index([status])
  @@index([doctorId])
}


// ============ ENCOUNTERS & QUEUES (PRD 11) ============
// Constraints Prisma can't express (partial unique indexes) live in the migration SQL — see 11 §4, §5.1.

model Encounter {
  id                 String          @id @default(uuid())
  organizationId     String
  encounterNumber    Int                                  // sequential per organisation, from SequenceCounter (11 §4.0)
  code               String                               // "ENC-26-00476": what staff, receipts and payers quote (11 §4.0)
  patientId          String
  branchId           String
  encounterType      EncounterType   @default(OUTPATIENT)
  status             EncounterStatus @default(OPEN)
  visitType          VisitType                            // how the patient came: walk-in, referral, ambulance…
  departmentId       String                               // the clinic's department (or Emergency); the ward's department once admitted
  clinicId           String?                              // the clinic the patient came to see (11 §3.3); null for emergency arrivals
  appointmentId      String?         @unique              // when checked in from a booking (07)
  parentEncounterId  String?                              // a newborn's encounter → the mother's delivery encounter (11 §4.2)
  followUpOfId       String?                              // the earlier encounter this one follows up (11 §15.3)
  attendingStaffId   String?                              // responsible clinician; consultant for inpatients
  reasonForVisit     String?                              // the chief complaint, recorded by the nurse at triage (11 §8), never by reception
  ageAtArrivalDays   Int?                                 // snapshot at check-in (06 §2.7); null if DOB unknown
  ageGroup           AgeGroup?                            // snapshot under the cutoffs in force that day
  acuity             Acuity?                              // latest emergency triage acuity, for task-list ordering
  triagePriority     QueuePriority?                       // latest outpatient triage priority, given to the encounter's tasks (11 §8.1)
  coverageId         String?                              // chosen at check-in (10 §5); null = self-pay
  referringFacility  String?
  referringClinician String?
  isMedicoLegal      Boolean         @default(false)
  policeReportNumber String?
  arrivedAt          DateTime        @default(now())
  firstSeenAt        DateTime?                            // first clinician contact (door-to-clinician)
  disposition        Disposition?
  dispositionAt      DateTime?
  dispositionBy      String?
  dispositionNote    String?
  dischargedAt       DateTime?
  closedAt           DateTime?                            // when the last task was completed or cancelled (11 §14)
  closedBy           String?
  closedAtQueueId    String?                              // the station that finished the last task
  cancelledReason    String?
  createdBy          String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id])
  patient            Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branch             Branch          @relation(fields: [branchId], references: [id])
  department         Department      @relation(fields: [departmentId], references: [id])
  clinic             Clinic?         @relation(fields: [clinicId], references: [id])
  appointment        Appointment?    @relation(fields: [appointmentId], references: [id])
  parent             Encounter?      @relation("EncounterChain", fields: [parentEncounterId], references: [id], onDelete: Cascade)
  children           Encounter[]     @relation("EncounterChain")
  followUpOf         Encounter?      @relation("FollowUp", fields: [followUpOfId], references: [id], onDelete: Cascade)
  followUps          Encounter[]     @relation("FollowUp")
  coverage           Coverage?       @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  queueEntries       QueueEntry[]
  charges            Charge[]
  triages            TriageAssessment[]
  vitals             Vitals[]
  consultations      Consultation[]
  diagnoses          Diagnosis[]

  @@unique([organizationId, encounterNumber])
  @@unique([organizationId, code])
  @@index([patientId, arrivedAt])
  @@index([branchId, status, encounterType])
}

// A patient's place at one station (11 §5)
model QueueEntry {
  id              String           @id @default(uuid())
  encounterId     String?                             // null only for a cashier task for fees outside a visit (registration)
  patientId       String                              // denormalised for worklist queries
  queueId         String
  branchId        String
  ticketNumber    Int                                 // per queue, per branch, per day (11 §5.4)
  priority        QueuePriority    @default(ROUTINE)
  priorityReason  String?
  status          QueueEntryStatus @default(WAITING)
  holdReason      HoldReason?                         // when status = HELD
  roomId          String?
  sourceType      String?                             // what the task is for: "ENCOUNTER_BILL" / "REGISTRATION_BILL" (billing tasks), "LAB_ORDER"…
  sourceId        String?
  fromEntryId     String?                             // the entry that routed the patient here
  enteredAt       DateTime         @default(now())
  readyAt         DateTime         @default(now())    // when it became callable (after a hold); orders the queue
  calledAt        DateTime?
  calledBy        String?
  callCount       Int              @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  servedBy        String?                             // who did the work: for a doctors' task, the doctor the patient saw
  outcomeNote     String?
  createdBy       String

  encounter       Encounter?       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queue           Queue            @relation(fields: [queueId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  fromEntry       QueueEntry?      @relation("QueueRouting", fields: [fromEntryId], references: [id], onDelete: Cascade)
  routedTo        QueueEntry[]     @relation("QueueRouting")
  consultation    Consultation?

  @@index([queueId, branchId, status, priority, readyAt])
  @@index([encounterId, status])
  @@index([sourceType, sourceId])
}

/// Counters incremented in one SQL statement (INSERT … ON CONFLICT … RETURNING), so concurrent
/// check-ins never share a number: queue tickets per queue per branch per day (11 §5.4), and
/// encounter numbers per organisation ("encounter:<organizationId>", 11 §4.0).
model SequenceCounter {
  scope      String @id   // "ticket:<queueId>:<branchId>:2026-10-19"
  lastNumber Int
}


// ============ BILLING (PRD 10) ============
// Money is Decimal(14,2); percentages are Decimal(5,2). Constraints Prisma can't express
// (partial unique indexes, CHECKs) live in the migration SQL — see 20261013*_billing_core.

// ------------ Accounts & ledger (§3) ------------

model BillingAccount {
  id              String             @id @default(uuid())
  organizationId  String
  accountNumber   String             @unique
  accountType     BillingAccountType
  name            String
  holderPatientId String?
  holderName      String?
  holderPhone     String[]
  payerId         String?            @unique
  balance         Decimal            @default(0.00) @db.Decimal(14, 2) // credits − debits; negative = owed
  unappliedCredit Decimal            @default(0.00) @db.Decimal(14, 2)
  creditLimit     Decimal            @default(0.00) @db.Decimal(14, 2)
  status          AccountStatus      @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  updatedBy       String?

  organization    Organization       @relation(fields: [organizationId], references: [id])
  holder          Patient?           @relation("AccountHolder", fields: [holderPatientId], references: [id], onDelete: Cascade)
  payer           Payer?             @relation(fields: [payerId], references: [id])
  members         BillingAccountMember[]
  entries         AccountEntry[]
  charges         Charge[]
  allocations     ChargeAllocation[]
  requests        FinancialRequest[]

  @@index([organizationId, accountType, status])
}

model BillingAccountMember {
  id        String    @id @default(uuid())
  accountId String
  patientId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime? // null = current member; one current membership per patient (partial unique index)
  createdBy String

  account   BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, leftAt])
  @@index([accountId, leftAt])
}

model AccountEntry {
  id            String           @id @default(uuid())
  accountId     String
  patientId     String?
  entryType     AccountEntryType
  amount        Decimal          @db.Decimal(14, 2) // signed: + credit, − debit
  balanceAfter  Decimal          @db.Decimal(14, 2)
  appliedAmount Decimal          @default(0) @db.Decimal(14, 2) // credits only: how much has paid allocations
  allocationId  String?
  requestId     String?          // required for WRITE_OFF/REFUND/TRANSFER_*/ADJUSTMENT (CHECK constraint)
  reversesId    String?          @unique
  modeOfPayment PaymentMode?
  reference     String?
  description   String           // the narration: "Deposit", or what the cashier typed
  paidByName    String?          // money in: who handed it over (10 §7.2)
  paidByPhone   String?
  branchId      String
  createdAt     DateTime         @default(now())
  createdBy     String

  account       BillingAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  patient       Patient?          @relation(fields: [patientId], references: [id], onDelete: Cascade)   // required on CHARGE (CHECK constraint)
  branch        Branch            @relation(fields: [branchId], references: [id])
  allocation    ChargeAllocation? @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  request       FinancialRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reverses      AccountEntry?     @relation("EntryReversal", fields: [reversesId], references: [id], onDelete: Cascade)
  reversedBy    AccountEntry?     @relation("EntryReversal")
  applications  PaymentApplication[]

  @@index([accountId, createdAt])
  @@index([patientId, createdAt])
  @@index([allocationId])
  @@index([branchId])
}

// ------------ Coverage (§4) ------------

model Payer {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  payerType       PayerType
  settlementMode  SettlementMode
  contactName     String?
  phone           String[]
  email           String?
  address         String?
  paymentTermDays Int?
  status          AccountStatus  @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  updatedBy       String?

  organization    Organization   @relation(fields: [organizationId], references: [id])
  account         BillingAccount?
  plans           Plan[]
  nhisWorkers     NHISWorker[]
  itemPrices      ItemPrice[]
  agreements      PayerAgreement[]
  discounts       PayerDiscount[]

  @@unique([organizationId, name])
}

model Plan {
  id                   String          @id @default(uuid())
  payerId              String
  name                 String
  copayPercent         Decimal         @default(0) @db.Decimal(5, 2) // PATIENT's share
  annualLimitPerMember Decimal?        @db.Decimal(14, 2)
  annualLimitPerPolicy Decimal?        @db.Decimal(14, 2)
  overLimitAction      OverLimitAction @default(BILL_TO_ACCOUNT)
  maxSpouses           Int             @default(0)
  maxChildren          Int             @default(0)
  childMaxAge          Int?
  allowOtherDependants Boolean         @default(false)
  status               AccountStatus   @default(ACTIVE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  updatedBy            String?

  payer                Payer           @relation(fields: [payerId], references: [id])
  benefits             PlanBenefit[]
  policies             Policy[]

  @@unique([payerId, name])
}

model PlanBenefit {
  id              String          @id @default(uuid())
  planId          String
  category        ServiceCategory
  covered         Boolean         @default(true)
  copayPercent    Decimal?        @db.Decimal(5, 2) // overrides Plan.copayPercent
  annualLimit     Decimal?        @db.Decimal(14, 2)
  requiresPreAuth Boolean         @default(false)

  plan            Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, category])
}

model Policy {
  id                 String       @id @default(uuid())
  planId             String
  policyNumber       String
  principalPatientId String
  validFrom          DateTime
  validTo            DateTime?
  status             PolicyStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  updatedBy          String?

  plan               Plan         @relation(fields: [planId], references: [id])
  principal          Patient      @relation("PolicyPrincipal", fields: [principalPatientId], references: [id], onDelete: Cascade)
  coverages          Coverage[]

  @@unique([planId, policyNumber])
  @@index([principalPatientId])
}

model Coverage {
  id           String       @id @default(uuid())
  policyId     String
  patientId    String
  memberType   MemberType   // one PRINCIPAL per policy (partial unique index)
  memberNumber String?
  priority     Int          @default(1)
  validFrom    DateTime
  validTo      DateTime?
  status       PolicyStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String

  policy       Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  charges      Charge[]
  allocations  ChargeAllocation[]
  encounters   Encounter[]

  @@unique([policyId, patientId])
  @@index([patientId, status])
}

// ------------ Billables & price catalog (12) ------------
// Price, cost and discount rows are append-only and dated: a change closes the open row and adds a new one (12 §6.3).
// Overlap exclusion and per-basis CHECK constraints are appended to the migration SQL (12 §5.1, §6.2, §8.1).

model BillableCategory {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  kind           ServiceCategory // system meaning; can't change once the category has items
  description    String?
  status         CatalogStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  createdBy      String
  updatedAt      DateTime        @updatedAt
  updatedBy      String?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  items          BillableItem[]

  @@unique([organizationId, name])
  @@index([organizationId, kind])
}

model BillableItem {
  id             String           @id @default(uuid())
  organizationId String
  categoryId     String
  code           String
  name           String
  description    String?
  unit           String           // what one quantity means: "test", "visit", "day", "tablet"
  status         CatalogStatus    @default(ACTIVE)
  createdAt      DateTime         @default(now())
  createdBy      String
  updatedAt      DateTime         @updatedAt
  updatedBy      String?

  organization   Organization     @relation(fields: [organizationId], references: [id])
  category       BillableCategory @relation(fields: [categoryId], references: [id])
  prices         ItemPrice[]
  costs          ItemCost[]
  clinicLinks    ClinicBillableItem[]
  charges        Charge[]
  stockItem      StockItem?

  @@unique([organizationId, code])
  @@unique([id, organizationId]) // target of ClinicBillableItem's composite FK
  @@index([organizationId, categoryId, status])
}

model ItemCost {
  id            String       @id @default(uuid())
  itemId        String
  packCost      Decimal      @db.Decimal(14, 2) // as invoiced; unit cost is never stored (12 §5.2)
  unitsPerPack  Int          @default(1)
  effectiveFrom DateTime     // inclusive
  effectiveTo   DateTime?    // exclusive; null = open-ended
  source        String?      // supplier invoice no., market survey…
  reason        String
  createdAt     DateTime     @default(now())
  createdBy     String
  endedAt       DateTime?
  endedBy       String?
  endReason     String?
  cancelledAt   DateTime?    // withdrawn before it took effect
  cancelledBy   String?

  item          BillableItem @relation(fields: [itemId], references: [id])
  charges       Charge[]
  receiptItems  GoodsReceiptItem[] // costs rolled forward by a goods receipt (15 §11)

  @@index([itemId, effectiveFrom])
}

model ItemPrice {
  id            String          @id @default(uuid())
  itemId        String
  payerId       String?         // null = self-pay
  basis         PriceBasis
  amount        Decimal?        @db.Decimal(14, 2) // TARIFF, MANUAL
  percent       Decimal?        @db.Decimal(5, 2)  // DISCOUNT (off self-pay), MARKUP (on cost)
  agreementId   String?         // required for TARIFF
  effectiveFrom DateTime        // inclusive
  effectiveTo   DateTime?       // exclusive; null = open-ended
  reason        String
  createdAt     DateTime        @default(now())
  createdBy     String
  endedAt       DateTime?
  endedBy       String?
  endReason     String?
  cancelledAt   DateTime?       // withdrawn before it took effect
  cancelledBy   String?

  item          BillableItem    @relation(fields: [itemId], references: [id])
  payer         Payer?          @relation(fields: [payerId], references: [id])
  // composite FK: the agreement must belong to this line's payer. Restrict, since SetNull would also null payerId
  agreement     PayerAgreement? @relation(fields: [agreementId, payerId], references: [id, payerId], onDelete: Restrict)
  charges       Charge[]

  @@index([itemId, payerId, effectiveFrom])
  @@index([payerId, effectiveFrom])
  @@index([agreementId])
}

model PayerAgreement {
  id          String      @id @default(uuid())
  payerId     String
  reference   String      // contract / tariff number
  title       String?
  signedOn    DateTime?
  validFrom   DateTime
  validTo     DateTime?
  documentRef String?
  notes       String?
  createdAt   DateTime    @default(now())
  createdBy   String
  updatedAt   DateTime    @updatedAt
  updatedBy   String?

  payer       Payer       @relation(fields: [payerId], references: [id])
  prices      ItemPrice[]
  charges     Charge[]

  @@unique([payerId, reference])
  @@unique([id, payerId]) // target of ItemPrice's composite FK
}

// Items used at a clinic, per organisation (clinics are system-wide): eye drops and glasses at Eye,
// consumables at Emergency. Many-to-many; a row is either there or not, never edited (12 §4.4).
model ClinicBillableItem {
  id             String       @id @default(uuid())
  organizationId String
  clinicId       String
  itemId         String
  createdAt      DateTime     @default(now())
  createdBy      String

  organization   Organization @relation(fields: [organizationId], references: [id])
  clinic         Clinic       @relation(fields: [clinicId], references: [id])
  // composite FK: the item must be this organisation's. Restrict, so a linked item can't be deleted
  item           BillableItem @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, clinicId, itemId])
  @@index([organizationId, itemId])
}

model PayerDiscount {
  id            String    @id @default(uuid())
  payerId       String
  percent       Decimal   @db.Decimal(5, 2) // off the self-pay price, for items with no payer line
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String
  createdAt     DateTime  @default(now())
  createdBy     String
  endedAt       DateTime?
  endedBy       String?
  endReason     String?
  cancelledAt   DateTime?
  cancelledBy   String?

  payer         Payer     @relation(fields: [payerId], references: [id])
  charges       Charge[]

  @@index([payerId, effectiveFrom])
}

// ------------ Inventory: drugs & consumables (15) ------------
// Stock is held per location + batch + status (StockBalance). StockMovement is append-only and an insert trigger is
// the only writer of StockBalance; triggers, partial indexes and CHECKs are appended to the migration SQL (15 §9.2).

// The medicine itself, as staff look for it: generic name, strength, one dosage form, one route (15 §3.1).
// Seeded by CareFusion (organizationId null) or added by a hospital, shown as USER_ADDED.
model Medicine {
  id              String                   @id @default(uuid())
  organizationId  String?                  // null = seeded; set = added by that hospital
  genericName     String                   // "Paracetamol", "Artemether + Lumefantrine"
  strength        String?                  // "500 mg", "250 mg/5 ml"; display text, part of identity
  dosageForm      DosageForm
  route           MedicineRoute
  ingredients     String[]                 @default([])
  aliases         String[]                 @default([]) // other names staff search by: "Acetaminophen", "PCM"
  bodySystems     MedicineBodySystem[]     @default([])
  atcCode         String?                  // the medicine's own WHO ATC code, kept as given
  legalCategory   LegalCategory            @default(POM)
  controlled      Boolean?                 // null = the source doesn't say
  presentation    String?                  // "Vial", "Ampoule"
  nhisCode        String?                  // NHIA drug list code: one per strength line
  description     String?
  sourceSystem    String?                  // "NHIA_MEDICINES_LIST"
  sourceUrl       String?
  searchText      String                   @default("") // lower(name + strength + aliases + ingredients), set by a trigger
  status          CatalogStatus            @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  createdBy       String?                  // null for seeded rows
  updatedAt       DateTime                 @updatedAt
  updatedBy       String?

  organization    Organization?            @relation(fields: [organizationId], references: [id])
  therapeuticUses MedicineTherapeuticUse[]
  stockItems      StockItem[]

  @@index([organizationId])
}

// What a medicine is used for, as staff ask for it: "Pain", "General anaesthesia" (15 §3.1). Built from the
// medicines data: the seeder creates a use the first time a medicine names its code.
model TherapeuticUse {
  id        String                   @id @default(uuid())
  code      String                   @unique // "GENERAL_ANAESTHESIA"
  name      String                   // "General anaesthesia"
  createdAt DateTime                 @default(now())

  medicines MedicineTherapeuticUse[]
}

model MedicineTherapeuticUse {
  medicineId String
  useId      String

  medicine   Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  use        TherapeuticUse @relation(fields: [useId], references: [id])

  @@id([medicineId, useId])
  @@index([useId])
}

// A billable the hospital holds in stock (1:1): "Emzor Paracetamol 500mg". PHARMACY-kind items must name their medicine.
model StockItem {
  itemId              String           @id
  organizationId      String
  medicineId          String?          // required for PHARMACY-kind items; its strength is the product's
  brandName           String?          // "Emzor Paracetamol"
  manufacturerId      String?          // the maker identifies the product, not the batch
  registrationNo      String?          // NAFDAC registration number
  batchTracked        Boolean          @default(true)  // batch number + expiry required on receipt
  quarantineOnReceipt Boolean          @default(false) // receipt lines default to QUARANTINE
  storageCondition    StorageCondition @default(ROOM_TEMPERATURE)
  createdAt           DateTime         @default(now())
  createdBy           String
  updatedAt           DateTime         @updatedAt
  updatedBy           String?

  item                BillableItem     @relation(fields: [itemId, organizationId], references: [id, organizationId])
  medicine            Medicine?        @relation(fields: [medicineId], references: [id])
  manufacturer        Manufacturer?    @relation(fields: [manufacturerId], references: [id])
  packs               ItemPack[]
  batches             StockBatch[]
  receiptItems        GoodsReceiptItem[]

  @@unique([itemId, organizationId]) // target of StockBatch's composite FK
  @@index([organizationId])
  @@index([medicineId])
  @@index([manufacturerId])
}

// How the item is bought or handled, in base units (BillableItem.unit). The base unit itself is an implicit pack of 1.
model ItemPack {
  id           String        @id @default(uuid())
  itemId       String
  name         String        // "Box of 100", "Strip of 10"
  unitsPerPack Int           // never edited; a new size is a new pack
  barcode      String?
  isDefault    Boolean       @default(false)
  status       CatalogStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  createdBy    String
  updatedAt    DateTime      @updatedAt
  updatedBy    String?

  stockItem    StockItem     @relation(fields: [itemId], references: [itemId])
  receiptItems GoodsReceiptItem[]

  @@unique([itemId, name])
}

model Supplier {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  contactName    String?
  phone          String[]
  email          String?
  address        String?
  taxId          String?       // TIN
  notes          String?
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  createdBy      String
  updatedAt      DateTime      @updatedAt
  updatedBy      String?

  organization   Organization  @relation(fields: [organizationId], references: [id])
  receipts       GoodsReceipt[]

  @@unique([organizationId, name])
}

// Who makes a product: picked or created when stocking an item, like suppliers.
model Manufacturer {
  id             String        @id @default(uuid())
  organizationId String
  name           String        // "Emzor Pharmaceutical Industries"
  country        String?
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  createdBy      String
  updatedAt      DateTime      @updatedAt
  updatedBy      String?

  organization   Organization  @relation(fields: [organizationId], references: [id])
  stockItems     StockItem[]

  @@unique([organizationId, name])
}

// A manufacturer's lot of one stock item. Created only by posting a receipt; later deliveries of the same lot reuse it.
model StockBatch {
  id               String       @id @default(uuid())
  organizationId   String
  itemId           String
  batchNumber      String?      // null only for items that aren't batch-tracked
  manufacturedOn   DateTime?    @db.Date
  expiryDate       DateTime?    @db.Date // required for batch-tracked items; expired from the day after
  qualityStatus    BatchQuality @default(RELEASED)
  qualityReason    String?
  qualityChangedAt DateTime?
  qualityChangedBy String?
  recallReference  String?      // required when RECALLED
  firstReceivedAt  DateTime     // FIFO tie-break; rotation order for untracked items
  createdAt        DateTime     @default(now())
  createdBy        String

  stockItem        StockItem    @relation(fields: [itemId, organizationId], references: [itemId, organizationId])
  balances         StockBalance[]
  movements        StockMovement[]
  receiptItems     GoodsReceiptItem[]

  @@unique([itemId, batchNumber]) // nulls distinct: every untracked receipt line gets its own batch
  @@unique([id, organizationId])
  @@index([itemId, expiryDate])
}

// A place stock is kept in a branch: Main Store, OPD Dispensary, Ward 3. Flat in v1 (15 §7).
model StorageLocation {
  id               String           @id @default(uuid())
  organizationId   String
  branchId         String
  code             String           // "MS", "OPD-DISP"
  name             String
  type             LocationType
  storageCondition StorageCondition @default(ROOM_TEMPERATURE)
  status           CatalogStatus    @default(ACTIVE)
  createdAt        DateTime         @default(now())
  createdBy        String
  updatedAt        DateTime         @updatedAt
  updatedBy        String?

  organization     Organization     @relation(fields: [organizationId], references: [id])
  branch           Branch           @relation(fields: [branchId], references: [id])
  balances         StockBalance[]
  movements        StockMovement[]
  receipts         GoodsReceipt[]
  receiptItems     GoodsReceiptItem[]

  @@unique([organizationId, code])
  @@unique([id, organizationId]) // target of balance and movement composite FKs
  @@index([organizationId, branchId])
}

// How much of one batch sits at one location in one status. Written only by the movement trigger; never by code.
model StockBalance {
  id             String          @id @default(uuid())
  organizationId String
  branchId       String
  locationId     String
  itemId         String
  batchId        String
  status         StockStatus
  quantity       Int             @default(0) // base units; CHECK >= 0
  updatedAt      DateTime        @updatedAt

  location       StorageLocation @relation(fields: [locationId, organizationId], references: [id, organizationId])
  batch          StockBatch      @relation(fields: [batchId, organizationId], references: [id, organizationId])

  @@unique([locationId, batchId, status])
  @@index([organizationId, itemId, status])
  @@index([batchId])
}

// One stock event (a receipt, a status change, an issue) and its movements.
model StockTransaction {
  id             String               @id @default(uuid())
  organizationId String
  branchId       String
  type           StockTransactionType
  sourceType     String?              // "GoodsReceipt", "Dispensing"…
  sourceId       String?
  reason         String?
  occurredAt     DateTime             @default(now())
  createdBy      String

  branch         Branch               @relation(fields: [branchId], references: [id])
  movements      StockMovement[]
  receipt        GoodsReceipt?

  @@index([organizationId, occurredAt])
  @@index([sourceType, sourceId])
}

// A signed change to one balance. Append-only.
model StockMovement {
  id             String           @id @default(uuid())
  transactionId  String
  organizationId String
  locationId     String
  itemId         String
  batchId        String
  status         StockStatus
  quantity       Int              // signed base units; never 0
  createdAt      DateTime         @default(now())

  transaction    StockTransaction @relation(fields: [transactionId], references: [id])
  location       StorageLocation  @relation(fields: [locationId, organizationId], references: [id, organizationId])
  batch          StockBatch       @relation(fields: [batchId, organizationId], references: [id, organizationId])

  @@index([transactionId])
  @@index([batchId, createdAt])
  @@index([locationId, itemId, createdAt])
  @@index([itemId, createdAt])
}

// A delivery (or opening stock) as it arrived. Drafts change no stock; posting is one transaction (15 §10.2).
model GoodsReceipt {
  id                  String          @id @default(uuid())
  organizationId      String
  branchId            String
  number              String          // "GRN-000123" (SequenceCounter "grn:<orgId>")
  type                ReceiptType     @default(DELIVERY)
  locationId          String          // where it's received; lines may put away elsewhere in the branch
  supplierId          String?         // required for DELIVERY
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?       @db.Date
  deliveryNote        String?
  receivedAt          DateTime        // when the goods physically arrived
  status              ReceiptStatus   @default(DRAFT)
  notes               String?
  transactionId       String?         @unique // set when posted
  createdAt           DateTime        @default(now())
  createdBy           String
  updatedAt           DateTime        @updatedAt
  updatedBy           String?
  postedAt            DateTime?
  postedBy            String?
  cancelledAt         DateTime?
  cancelledBy         String?
  cancelReason        String?

  organization        Organization     @relation(fields: [organizationId], references: [id])
  branch              Branch           @relation(fields: [branchId], references: [id])
  location            StorageLocation  @relation(fields: [locationId], references: [id])
  supplier            Supplier?        @relation(fields: [supplierId], references: [id])
  transaction         StockTransaction? @relation(fields: [transactionId], references: [id])
  items               GoodsReceiptItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status, receivedAt])
  @@index([supplierId, receivedAt])
}

model GoodsReceiptItem {
  id             String           @id @default(uuid())
  receiptId      String
  itemId         String
  packId         String?          // null = received in base units
  packName       String           // snapshot: "Box of 100"
  unitsPerPack   Int              // snapshot
  packsDelivered Int
  packsAccepted  Int              // only accepted packs enter stock
  rejectReason   String?          // required when fewer accepted than delivered
  packCost       Decimal          @db.Decimal(14, 2) // as on the invoice line
  batchNumber    String?
  manufacturedOn DateTime?        @db.Date
  expiryDate     DateTime?        @db.Date
  locationId     String?          // put-away override within the receipt's branch
  receiveAs      StockStatus      @default(AVAILABLE) // AVAILABLE | QUARANTINE
  updateCost     Boolean          @default(true)      // roll ItemCost forward on posting (15 §11)
  keepCostReason String?          // required when updateCost is false
  batchId        String?          // set on posting
  itemCostId     String?          // set when posting rolled the cost
  createdAt      DateTime         @default(now())

  receipt        GoodsReceipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  stockItem      StockItem        @relation(fields: [itemId], references: [itemId])
  pack           ItemPack?        @relation(fields: [packId], references: [id])
  location       StorageLocation? @relation(fields: [locationId], references: [id])
  batch          StockBatch?      @relation(fields: [batchId], references: [id])
  itemCost       ItemCost?        @relation(fields: [itemCostId], references: [id])

  @@index([receiptId])
  @@index([itemId])
  @@index([batchId])
}

// ------------ Charges & allocation (§5, §6) ------------

model Charge {
  id               String          @id @default(uuid())
  patientId        String
  branchId         String
  appointmentId    String?
  encounterId      String?                         // the visit it was incurred in (11 §17); null for registration fees
  billingAccountId String          // patient's account at posting time (snapshot)
  coverageId       String?
  category         ServiceCategory
  description      String
  quantity         Decimal         @default(1) @db.Decimal(12, 3) // 2.5 bed-days, 7.5 ml (13 D8)
  unitPrice        Decimal         @db.Decimal(14, 2)
  amount           Decimal         @db.Decimal(14, 2)
  sourceType       String
  sourceId         String
  status           ChargeStatus    @default(POSTED)
  createdAt        DateTime        @default(now())
  createdBy        String
  // what was sold and how its price was reached (13 §3); null only on charges posted before PRD 13
  billableItemId   String?
  pricingBasis     PriceBasis?
  priceSource      PriceSource?
  itemPriceId      String?
  itemCostId       String?
  agreementId      String?
  payerDiscountId  String?
  pricePercent     Decimal?        @db.Decimal(5, 2)

  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branch           Branch          @relation(fields: [branchId], references: [id])
  encounter        Encounter?      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  billingAccount   BillingAccount  @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  coverage         Coverage?       @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  billableItem     BillableItem?   @relation(fields: [billableItemId], references: [id])
  itemPrice        ItemPrice?      @relation(fields: [itemPriceId], references: [id])
  itemCost         ItemCost?       @relation(fields: [itemCostId], references: [id])
  agreement        PayerAgreement? @relation(fields: [agreementId], references: [id])
  payerDiscount    PayerDiscount?  @relation(fields: [payerDiscountId], references: [id])
  allocations      ChargeAllocation[]
  requests         FinancialRequest[]

  @@index([patientId, createdAt])
  @@index([billingAccountId, createdAt])
  @@index([sourceType, sourceId])
  @@index([appointmentId])
  @@index([encounterId])
  @@index([billableItemId])
}

model ChargeAllocation {
  id                String           @id @default(uuid())
  chargeId          String
  responsibleType   ResponsibleType
  billingAccountId  String?
  coverageId        String?
  basis             AllocationBasis
  amount            Decimal          @db.Decimal(14, 2)
  state             AllocationState  @default(ACTIVE)
  replacesId        String?
  requestId         String?

  reviewStatus      ReviewStatus?
  authorizationCode String?
  reviewedAt        DateTime?
  reviewedBy        String?
  rejectionReason   String?

  paidAmount        Decimal          @default(0) @db.Decimal(14, 2)
  paymentStatus     PaymentStatus

  createdAt         DateTime         @default(now())
  createdBy         String

  charge            Charge            @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  billingAccount    BillingAccount?   @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  coverage          Coverage?         @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  replaces          ChargeAllocation? @relation("AllocationLineage", fields: [replacesId], references: [id], onDelete: Cascade)
  replacedBy        ChargeAllocation[] @relation("AllocationLineage")
  request           FinancialRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  entries           AccountEntry[]
  applications      PaymentApplication[]
  requestTargets    FinancialRequestTarget[]

  @@index([chargeId, state])
  @@index([billingAccountId, paymentStatus, state])
  @@index([coverageId, reviewStatus])
}

model BenefitUsage {
  id          String           @id @default(uuid())
  scope       UsageScope
  scopeId     String           // coverageId (MEMBER) or policyId (POLICY)
  category    ServiceCategory? // null = overall annual limit
  periodStart DateTime
  periodEnd   DateTime
  usedAmount  Decimal          @default(0) @db.Decimal(14, 2)

  // NULLS NOT DISTINCT (so the null-category row is unique too) is applied in the migration SQL
  @@unique([scope, scopeId, category, periodStart])
}

// ------------ Reconciliation (§7) ------------

model PaymentApplication {
  id            String    @id @default(uuid())
  creditEntryId String
  allocationId  String
  amount        Decimal   @db.Decimal(14, 2)
  appliedAt     DateTime  @default(now())
  appliedBy     String
  reversedAt    DateTime?
  reversedBy    String?

  creditEntry   AccountEntry     @relation(fields: [creditEntryId], references: [id], onDelete: Cascade)
  allocation    ChargeAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([allocationId])
  @@index([creditEntryId])
}

// ------------ Financial requests (§8) ------------

model FinancialRequest {
  id                String                 @id @default(uuid())
  organizationId    String
  branchId          String
  requestType       FinancialRequestType
  amount            Decimal                @db.Decimal(14, 2)
  reasonCode        FinancialReason
  narrative         String
  billingAccountId  String?
  chargeId          String?
  payload           Json?
  requiredApprovals Int
  status            FinancialRequestStatus @default(PENDING)
  requestedBy       String
  requestedAt       DateTime               @default(now())
  decidedAt         DateTime?
  cancelledBy       String?
  cancelledAt       DateTime?

  organization      Organization           @relation(fields: [organizationId], references: [id])
  billingAccount    BillingAccount?        @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  charge            Charge?                @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  targets           FinancialRequestTarget[]
  approvals         FinancialRequestApproval[]
  attachments       FinancialRequestAttachment[]
  entries           AccountEntry[]
  allocations       ChargeAllocation[]

  @@index([organizationId, status, requestType])
  @@index([requestedBy])
}

model FinancialRequestTarget {
  id           String  @id @default(uuid())
  requestId    String
  allocationId String
  amount       Decimal @db.Decimal(14, 2)

  request      FinancialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  allocation   ChargeAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@unique([requestId, allocationId])
}

model FinancialRequestApproval {
  id            String           @id @default(uuid())
  requestId     String
  approverId    String
  decision      ApprovalDecision
  note          String
  approverLimit Decimal          @db.Decimal(14, 2)
  decidedAt     DateTime         @default(now())

  request       FinancialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverId])
}

model FinancialRequestAttachment {
  id          String   @id @default(uuid())
  requestId   String
  fileRef     String
  fileName    String
  mimeType    String
  sha256      String
  description String?
  uploadedBy  String
  uploadedAt  DateTime @default(now())

  request     FinancialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model ApprovalLimit {
  id            String               @id @default(uuid())
  dutyProfileId String
  requestType   FinancialRequestType
  maxAmount     Decimal              @db.Decimal(14, 2)
  updatedAt     DateTime             @updatedAt
  updatedBy     String?

  dutyProfile   DutyProfile          @relation(fields: [dutyProfileId], references: [id], onDelete: Cascade)

  @@unique([dutyProfileId, requestType])
}

model ApprovalPolicy {
  id                String               @id @default(uuid())
  organizationId    String
  requestType       FinancialRequestType
  dualApprovalAbove Decimal?             @db.Decimal(14, 2) // null = single approval always
  updatedAt         DateTime             @updatedAt
  updatedBy         String?

  organization      Organization         @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, requestType])
}

