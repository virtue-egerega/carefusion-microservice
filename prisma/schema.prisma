// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {

  id                    String   @id @default(uuid())
  name                  String
  address               String
  logo                  String?
  phone                 String[]
  email                 String
  city                  String
  state                 String
  country               String
  zipCode               String
  website               String?
  slogan                String?
  pobox                 String?
  nfcCardFee            Decimal @default(1000.00)
  registrationFee       Decimal @default(0.00)
  paymentPlan           PaymentPlan?
  businessType          BusinessType @default(HOSPITAL)
  orgType               OrgType @default(STANDALONE)
  healthcareNetworkId   String?
  healthcareNetworkName String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime? @updatedAt
  deletedBy             String?


  branches               Branch[]
  staffs                 HospitalStaff[]
  patients               Patient[]
  billingAccounts        BillingAccount[]
  payers                 Payer[]
  financialRequests      FinancialRequest[]
  approvalPolicies       ApprovalPolicy[]

}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String       @unique
  address        String
  city           String
  state          String
  country        String
  phone          String[]
  email          String?
  isMainBranch   Boolean      @default(false)
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  charges        Charge[]
  accountEntries AccountEntry[]

  @@index([organizationId])
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  firstName             String
  middleName            String?
  lastName              String
  phone                 String[]
  type                  UserType
  status                UserStatus @default(ACTIVE)
  loginAttempts         Int       @default(0)
  mustChangePassword    Boolean   @default(false) // set when an admin issues a temporary password (creation or reset)
  refreshToken          String?
  lastLogin             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  updatedBy             String?         // userId of the user who updated this role
  deletedAt             DateTime?       // soft delete
  deletedBy             String?         // userId of the user who updated this role

  personalAccessTokens  PersonalAccessToken[]
  passwordHistory       PasswordHistory[]
  address              Address[]

  staff                 HospitalStaff?
  patient               Patient?
  nhisWorker            NHISWorker?
  publicHealthWorker    PublicHealthWorker?

  @@index([email, lastName], name: "email_lastname_index")
  @@index([phone, lastName], name: "phone_lastname_index")
}


model PasswordHistory{
  id          String @id @default(uuid())
  userId      String
  password    String                         // the hash that was replaced
  changedBy   String?                        // who set the new password: the admin (reset) or the user
  reason      PasswordChangeReason?
  createdAt   DateTime @default(now())
  updatedAt   DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/* PersonalAccessToken - for all types of code verification*/
model PersonalAccessToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  type       TokenType
  expiry     DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type])
}


// ------------ ACCESS CONTROL ------------

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  dutyProfilePermissions DutyProfilePermission[]
}

model DutyProfile {
  id           String            @id @default(uuid())
  name         String            @unique
  role         HospitalStaffRole
  departmentId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  department  Department? @relation(fields: [departmentId], references: [id])
  queues      DutyProfileQueue[]
  permissions DutyProfilePermission[]
  assignments StaffAssignment[]
  approvalLimits ApprovalLimit[]
}

model DutyProfileQueue {
  id            String @id @default(uuid())
  dutyProfileId String
  queueId       String

  dutyProfile DutyProfile @relation(fields: [dutyProfileId], references: [id], onDelete: Cascade)
  queue       Queue       @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@unique([dutyProfileId, queueId])
}

model DutyProfilePermission {
  id            String @id @default(uuid())
  dutyProfileId String
  permissionId  String

  dutyProfile DutyProfile @relation(fields: [dutyProfileId], references: [id], onDelete: Cascade)
  permission  Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([dutyProfileId, permissionId])
}

model StaffAssignment {
  id            String    @id @default(uuid())
  staffId       String
  dutyProfileId String
  assignedBy    String
  assignedAt    DateTime  @default(now())
  endsAt        DateTime?

  staff       HospitalStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dutyProfile DutyProfile   @relation(fields: [dutyProfileId], references: [id], onDelete: Cascade)

  @@unique([staffId, dutyProfileId])
}

// ------------ DEPARTMENTS & QUEUES ------------

model Department {
  id          String    @id @default(uuid())
  systemKey   String    @unique
  name        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  staff        HospitalStaff[]
  queues       Queue[]
  dutyProfiles DutyProfile[]
}

model Queue {
  id           String     @id @default(uuid())
  departmentId String
  systemKey    String     @unique
  name         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  department        Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  dutyProfileQueues DutyProfileQueue[]

  @@index([departmentId])
}

// ------------ STAFF ------------
model HospitalStaff {
  id             String      @id @default(uuid()) @map("user_id")
  user           User        @relation(fields: [id], references: [id], onDelete: Cascade)
  departmentId   String?
  hospitalId     String?
  role           HospitalStaffRole?
  createdAt      DateTime    @default(now())
  createdBy      String?                       // admin who created the account (and issued its first password)

  department     Department?    @relation(fields: [departmentId], references: [id])
  hospital       Organization?  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  assignments    StaffAssignment[]
}

// ------------ PATIENT ------------

model Address {
  id                    String      @id @default(uuid())
  street                String
  city                  String
  state                 String
  country               String
  postalCode            String?
  type                  AddressType
  userId                String?     // If tied to User
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  updatedBy             String?         // userId of the user who updated this role
  deletedAt             DateTime?       // soft delete
  deletedBy             String?


  user                  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type]) // 👈 ensures 1 address per type per patient
}

model Patient {
  id                    String  @id @default(uuid())  @map("user_id")
  patientId             Int     @default(autoincrement())
  nfcId                 String @unique     // the NFC card’s UID or token
  nfcLinkedAt           DateTime?          // when the card was linked to the patient
  nfcLinkedBy           String?          // who did the linking
  dateOfBirth           DateTime?
  sex                   Gender?
  maritalStatus         MaritalStatus?
  nationality           String?
  occupation            String?
  religion              String?
  ethnicity             String?
  spokenLanguages       String[]
  bloodGroup            BloodGroup?
  genotype              Genotype?
  emergencyContactId    String?
  emergencyContact       NextOfKin[]
  hospitalId             String  @map("hospital_id")

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                      User    @relation(fields: [id], references: [id], onDelete: Cascade)
  hospital                  Organization    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  heldBillingAccounts       BillingAccount[]       @relation("AccountHolder")
  billingMemberships        BillingAccountMember[]
  principalPolicies         Policy[]               @relation("PolicyPrincipal")
  coverages                 Coverage[]
  charges                   Charge[]

}

model NextOfKin {
  id              String   @id @default(uuid())
  patientId       String
  firstName       String
  middleName      String
  lastName        String
  relationship    String   // e.g. "Mother", "Brother", "Spouse"
  phone           String[]
  email           String?
  address         String?
  isEmergencyContact Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId, isEmergencyContact], name: "emergency_contact_index")
  @@index([patientId], name: "patient_contact_index")
  @@unique([patientId, isEmergencyContact])
}


// ------------ NHIS WORKER ------------
// insurance works account
model NHISWorker {
  id                    String   @id @default(uuid()) @map("user_id")
  user                  User     @relation(fields: [id], references: [id], onDelete: Cascade)
  role                  NHISRole?
  payerId               String

  payer                 Payer    @relation(fields: [payerId], references: [id])

}


// ------------ PUBLIC HEALTH WORKER ------------

model PublicHealthWorker {
  id              String   @id @default(uuid()) @map("user_id")
  user            User     @relation(fields: [id], references: [id], onDelete: Cascade)
  role            PublicHealthRole?
}


// ------------ NOTIFICATIONS ------------

model Notification {
  id          String @id @default(uuid())
  userId      String
  message     String
  type        NotificationType
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

}


// ------------ APPOINTMENTS ------------


model ConsultationType {
  id              String     @id @default(uuid())
  name            String     @unique
  description     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  updatedBy             String?         // userId of the user who updated this role
  deletedAt             DateTime?       // soft delete
  deletedBy             String?

  appointments          Appointment[]
}

// doctors and front desk can schedule appointment
model Appointment {
  id                          String     @id @default(uuid())
  hospitalId                  String
  date                        DateTime
  appointmentStartedAt        DateTime?
  appointmentEndedAt          DateTime?
  checkin                     Boolean? @default(false)
  checkinAt                   DateTime?
  status                      AppointmentStatus @default(SCHEDULED)
  reason                      ConsultationReason
  consultationTypeId          String
  patientId                   String
  doctorId                    String
  referralNote                String?
  referredById                String?

  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  updatedBy                   String?         // userId of the user who updated this role
  deletedAt                   DateTime?       // soft delete
  deletedBy                   String?
  consultationType            ConsultationType @relation(fields: [consultationTypeId], references: [id], onDelete: NoAction)

  @@index([patientId])
  @@index([hospitalId])
  @@index([date])
  @@index([checkinAt])
  @@index([status])
  @@index([doctorId])
}


// ============ BILLING (PRD 10) ============
// Money is Decimal(14,2); percentages are Decimal(5,2). Constraints Prisma can't express
// (partial unique indexes, CHECKs) live in the migration SQL — see 20261013*_billing_core.

// ------------ Accounts & ledger (§3) ------------

model BillingAccount {
  id              String             @id @default(uuid())
  organizationId  String
  accountNumber   String             @unique
  accountType     BillingAccountType
  name            String
  holderPatientId String?
  holderName      String?
  holderPhone     String[]
  payerId         String?            @unique
  balance         Decimal            @default(0.00) @db.Decimal(14, 2) // credits − debits; negative = owed
  unappliedCredit Decimal            @default(0.00) @db.Decimal(14, 2)
  creditLimit     Decimal            @default(0.00) @db.Decimal(14, 2)
  status          AccountStatus      @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  updatedBy       String?

  organization    Organization       @relation(fields: [organizationId], references: [id])
  holder          Patient?           @relation("AccountHolder", fields: [holderPatientId], references: [id])
  payer           Payer?             @relation(fields: [payerId], references: [id])
  members         BillingAccountMember[]
  entries         AccountEntry[]
  charges         Charge[]
  allocations     ChargeAllocation[]
  requests        FinancialRequest[]

  @@index([organizationId, accountType, status])
}

model BillingAccountMember {
  id        String    @id @default(uuid())
  accountId String
  patientId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime? // null = current member; one current membership per patient (partial unique index)
  createdBy String

  account   BillingAccount @relation(fields: [accountId], references: [id])
  patient   Patient        @relation(fields: [patientId], references: [id])

  @@index([patientId, leftAt])
  @@index([accountId, leftAt])
}

model AccountEntry {
  id            String           @id @default(uuid())
  accountId     String
  patientId     String?
  entryType     AccountEntryType
  amount        Decimal          @db.Decimal(14, 2) // signed: + credit, − debit
  balanceAfter  Decimal          @db.Decimal(14, 2)
  appliedAmount Decimal          @default(0) @db.Decimal(14, 2) // credits only: how much has paid allocations
  allocationId  String?
  requestId     String?          // required for WRITE_OFF/REFUND/TRANSFER_*/ADJUSTMENT (CHECK constraint)
  reversesId    String?          @unique
  modeOfPayment PaymentMode?
  reference     String?
  description   String
  branchId      String
  createdAt     DateTime         @default(now())
  createdBy     String

  account       BillingAccount    @relation(fields: [accountId], references: [id])
  branch        Branch            @relation(fields: [branchId], references: [id])
  allocation    ChargeAllocation? @relation(fields: [allocationId], references: [id])
  request       FinancialRequest? @relation(fields: [requestId], references: [id])
  reverses      AccountEntry?     @relation("EntryReversal", fields: [reversesId], references: [id])
  reversedBy    AccountEntry?     @relation("EntryReversal")
  applications  PaymentApplication[]

  @@index([accountId, createdAt])
  @@index([patientId, createdAt])
  @@index([allocationId])
  @@index([branchId])
}

// ------------ Coverage (§4) ------------

model Payer {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  payerType       PayerType
  settlementMode  SettlementMode
  contactName     String?
  phone           String[]
  email           String?
  address         String?
  paymentTermDays Int?
  status          AccountStatus  @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  updatedBy       String?

  organization    Organization   @relation(fields: [organizationId], references: [id])
  account         BillingAccount?
  plans           Plan[]
  nhisWorkers     NHISWorker[]

  @@unique([organizationId, name])
}

model Plan {
  id                   String          @id @default(uuid())
  payerId              String
  name                 String
  copayPercent         Decimal         @default(0) @db.Decimal(5, 2) // PATIENT's share
  annualLimitPerMember Decimal?        @db.Decimal(14, 2)
  annualLimitPerPolicy Decimal?        @db.Decimal(14, 2)
  overLimitAction      OverLimitAction @default(BILL_TO_ACCOUNT)
  maxSpouses           Int             @default(0)
  maxChildren          Int             @default(0)
  childMaxAge          Int?
  allowOtherDependants Boolean         @default(false)
  status               AccountStatus   @default(ACTIVE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  updatedBy            String?

  payer                Payer           @relation(fields: [payerId], references: [id])
  benefits             PlanBenefit[]
  policies             Policy[]

  @@unique([payerId, name])
}

model PlanBenefit {
  id              String          @id @default(uuid())
  planId          String
  category        ServiceCategory
  covered         Boolean         @default(true)
  copayPercent    Decimal?        @db.Decimal(5, 2) // overrides Plan.copayPercent
  annualLimit     Decimal?        @db.Decimal(14, 2)
  requiresPreAuth Boolean         @default(false)

  plan            Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, category])
}

model Policy {
  id                 String       @id @default(uuid())
  planId             String
  policyNumber       String
  principalPatientId String
  validFrom          DateTime
  validTo            DateTime?
  status             PolicyStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  updatedBy          String?

  plan               Plan         @relation(fields: [planId], references: [id])
  principal          Patient      @relation("PolicyPrincipal", fields: [principalPatientId], references: [id])
  coverages          Coverage[]

  @@unique([planId, policyNumber])
  @@index([principalPatientId])
}

model Coverage {
  id           String       @id @default(uuid())
  policyId     String
  patientId    String
  memberType   MemberType   // one PRINCIPAL per policy (partial unique index)
  memberNumber String?
  priority     Int          @default(1)
  validFrom    DateTime
  validTo      DateTime?
  status       PolicyStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String

  policy       Policy       @relation(fields: [policyId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  charges      Charge[]
  allocations  ChargeAllocation[]

  @@unique([policyId, patientId])
  @@index([patientId, status])
}

// ------------ Charges & allocation (§5, §6) ------------

model Charge {
  id               String          @id @default(uuid())
  patientId        String
  branchId         String
  appointmentId    String?
  billingAccountId String          // patient's account at posting time (snapshot)
  coverageId       String?
  category         ServiceCategory
  description      String
  quantity         Int             @default(1)
  unitPrice        Decimal         @db.Decimal(14, 2)
  amount           Decimal         @db.Decimal(14, 2)
  sourceType       String
  sourceId         String
  status           ChargeStatus    @default(POSTED)
  createdAt        DateTime        @default(now())
  createdBy        String

  patient          Patient         @relation(fields: [patientId], references: [id])
  branch           Branch          @relation(fields: [branchId], references: [id])
  billingAccount   BillingAccount  @relation(fields: [billingAccountId], references: [id])
  coverage         Coverage?       @relation(fields: [coverageId], references: [id])
  allocations      ChargeAllocation[]
  requests         FinancialRequest[]

  @@index([patientId, createdAt])
  @@index([billingAccountId, createdAt])
  @@index([sourceType, sourceId])
  @@index([appointmentId])
}

model ChargeAllocation {
  id                String           @id @default(uuid())
  chargeId          String
  responsibleType   ResponsibleType
  billingAccountId  String?
  coverageId        String?
  basis             AllocationBasis
  amount            Decimal          @db.Decimal(14, 2)
  state             AllocationState  @default(ACTIVE)
  replacesId        String?
  requestId         String?

  reviewStatus      ReviewStatus?
  authorizationCode String?
  reviewedAt        DateTime?
  reviewedBy        String?
  rejectionReason   String?

  paidAmount        Decimal          @default(0) @db.Decimal(14, 2)
  paymentStatus     PaymentStatus

  createdAt         DateTime         @default(now())
  createdBy         String

  charge            Charge            @relation(fields: [chargeId], references: [id])
  billingAccount    BillingAccount?   @relation(fields: [billingAccountId], references: [id])
  coverage          Coverage?         @relation(fields: [coverageId], references: [id])
  replaces          ChargeAllocation? @relation("AllocationLineage", fields: [replacesId], references: [id])
  replacedBy        ChargeAllocation[] @relation("AllocationLineage")
  request           FinancialRequest? @relation(fields: [requestId], references: [id])
  entries           AccountEntry[]
  applications      PaymentApplication[]
  requestTargets    FinancialRequestTarget[]

  @@index([chargeId, state])
  @@index([billingAccountId, paymentStatus, state])
  @@index([coverageId, reviewStatus])
}

model BenefitUsage {
  id          String           @id @default(uuid())
  scope       UsageScope
  scopeId     String           // coverageId (MEMBER) or policyId (POLICY)
  category    ServiceCategory? // null = overall annual limit
  periodStart DateTime
  periodEnd   DateTime
  usedAmount  Decimal          @default(0) @db.Decimal(14, 2)

  // NULLS NOT DISTINCT (so the null-category row is unique too) is applied in the migration SQL
  @@unique([scope, scopeId, category, periodStart])
}

// ------------ Reconciliation (§7) ------------

model PaymentApplication {
  id            String    @id @default(uuid())
  creditEntryId String
  allocationId  String
  amount        Decimal   @db.Decimal(14, 2)
  appliedAt     DateTime  @default(now())
  appliedBy     String
  reversedAt    DateTime?
  reversedBy    String?

  creditEntry   AccountEntry     @relation(fields: [creditEntryId], references: [id])
  allocation    ChargeAllocation @relation(fields: [allocationId], references: [id])

  @@index([allocationId])
  @@index([creditEntryId])
}

// ------------ Financial requests (§8) ------------

model FinancialRequest {
  id                String                 @id @default(uuid())
  organizationId    String
  branchId          String
  requestType       FinancialRequestType
  amount            Decimal                @db.Decimal(14, 2)
  reasonCode        FinancialReason
  narrative         String
  billingAccountId  String?
  chargeId          String?
  payload           Json?
  requiredApprovals Int
  status            FinancialRequestStatus @default(PENDING)
  requestedBy       String
  requestedAt       DateTime               @default(now())
  decidedAt         DateTime?
  cancelledBy       String?
  cancelledAt       DateTime?

  organization      Organization           @relation(fields: [organizationId], references: [id])
  billingAccount    BillingAccount?        @relation(fields: [billingAccountId], references: [id])
  charge            Charge?                @relation(fields: [chargeId], references: [id])
  targets           FinancialRequestTarget[]
  approvals         FinancialRequestApproval[]
  attachments       FinancialRequestAttachment[]
  entries           AccountEntry[]
  allocations       ChargeAllocation[]

  @@index([organizationId, status, requestType])
  @@index([requestedBy])
}

model FinancialRequestTarget {
  id           String  @id @default(uuid())
  requestId    String
  allocationId String
  amount       Decimal @db.Decimal(14, 2)

  request      FinancialRequest @relation(fields: [requestId], references: [id])
  allocation   ChargeAllocation @relation(fields: [allocationId], references: [id])

  @@unique([requestId, allocationId])
}

model FinancialRequestApproval {
  id            String           @id @default(uuid())
  requestId     String
  approverId    String
  decision      ApprovalDecision
  note          String
  approverLimit Decimal          @db.Decimal(14, 2)
  decidedAt     DateTime         @default(now())

  request       FinancialRequest @relation(fields: [requestId], references: [id])

  @@unique([requestId, approverId])
}

model FinancialRequestAttachment {
  id          String   @id @default(uuid())
  requestId   String
  fileRef     String
  fileName    String
  mimeType    String
  sha256      String
  description String?
  uploadedBy  String
  uploadedAt  DateTime @default(now())

  request     FinancialRequest @relation(fields: [requestId], references: [id])
}

model ApprovalLimit {
  id            String               @id @default(uuid())
  dutyProfileId String
  requestType   FinancialRequestType
  maxAmount     Decimal              @db.Decimal(14, 2)
  updatedAt     DateTime             @updatedAt
  updatedBy     String?

  dutyProfile   DutyProfile          @relation(fields: [dutyProfileId], references: [id], onDelete: Cascade)

  @@unique([dutyProfileId, requestType])
}

model ApprovalPolicy {
  id                String               @id @default(uuid())
  organizationId    String
  requestType       FinancialRequestType
  dualApprovalAbove Decimal?             @db.Decimal(14, 2) // null = single approval always
  updatedAt         DateTime             @updatedAt
  updatedBy         String?

  organization      Organization         @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, requestType])
}

// ============ ENUMS ============


enum PublicHealthRole {
  INSPECTOR
  DATA_ANALYST
  SUPERVISOR
  OTHER
}
enum Gender {
  MALE
  FEMALE
  OTHER
}


enum NHISRole {
  ADMIN
  VERIFIER
  CLAIMS_PROCESSOR
  OTHER
}


enum PaymentPlan {
  EPIC
  PREMIUM
  EXQUISITE
}

enum BusinessType {
  HOSPITAL
  LABORATORY
  PHARMACY
}

enum OrgType {
  STANDALONE
  CHAIN
}

enum UserStatus {
  ACTIVE
  NOTAPPROVED //admin account
  RESTRICTED
  DELETED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum AddressType {
  RESIDENCE
  WORK
  ORIGIN
}

enum TokenType {
  SESSION
  API
  PASSWORDRESET
  DELETEACCOUNT
  VERIFYACCOUNT
}
enum HospitalStaffRole {
  ADMIN
  SUPERADMIN
